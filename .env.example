# Kakao Maps JavaScript API Key
# 발급: https://developers.kakao.com → 내 애플리케이션 → JavaScript 키
# 도메인 등록 필수: localhost, localhost:8081, 배포 도메인
EXPO_PUBLIC_KAKAO_JS_KEY=YOUR_KAKAO_JS_KEY_HERE

# 공공데이터포털 인증키 — Vercel 서버리스 함수에서만 사용 (클라이언트 노출 X)
# EXPO_PUBLIC_ 접두사 없음 → 빌드 시 클라이언트 번들에 포함되지 않음.
# 발급: https://www.data.go.kr → 마이페이지 → 인증키 발급현황
# 사용처: poisonmap 비공식 API 죽었을 때 fallback (기상청 단기예보·에어코리아·생활기상지수)
# 한 키로 활용신청한 모든 API 호출 가능. Encoding/Decoding 키 모두 작동.
DATA_GO_KR_KEY=YOUR_DATA_GO_KR_KEY_HERE
