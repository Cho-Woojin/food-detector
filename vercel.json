{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "(?<deploy>.+)-cho-woojins-projects\\.vercel\\.app"
        }
      ],
      "destination": "https://food-detector-dun.vercel.app/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/restaurant/:id",
      "destination": "/restaurant/[id]"
    },
    {
      "source": "/((?!_expo/|api/|assets/|favicon\\.ico|.*\\.html|.*\\.js|.*\\.css|.*\\.png|.*\\.svg|.*\\.json).*)",
      "destination": "/index.html"
    }
  ]
}
